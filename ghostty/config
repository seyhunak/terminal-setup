# ============================================
# Ghostty Terminal - Complete Configuration
# ============================================
# File: ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS)

# --- Typography ---
font-family = JetBrainsMonoNerdFontMono
font-size = 13
font-feature = +calt,+liga,+ss01
font-thicken = true
adjust-cell-height = 4

# --- Theme and Colors ---
# Catppuccin with automatic light/dark switching
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
window-theme = auto

# --- Window and Appearance ---
background-opacity = 0.92
background-blur-radius = 20
macos-titlebar-style = transparent
macos-option-as-alt = true
window-padding-x = 12
window-padding-y = 10
window-save-state = always
confirm-close-surface = false
quit-after-last-window-closed = false

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false
cursor-opacity = 0.8

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Clipboard / Security ---
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration ---
command = /opt/homebrew/bin/fish --login
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- Keybindings ---
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# lazygit + yazi popups (new_split only takes a direction, so chain a
# text action to type the command in the new split; \x0d = Enter)
keybind = cmd+g=new_split:right
keybind = chain=text:lazygit\x0d
keybind = cmd+shift+o=new_split:right
keybind = chain=text:yazi\x0d

# agent layout (tmux session: editor/agent/server) in a new tab
keybind = cmd+shift+a=new_tab
keybind = chain=text:agent-layout.sh\x0d

# leader/worker duo (left cline leader, right cline worker, right lazygit)
keybind = cmd+shift+s=new_tab
keybind = chain=text:agent-duo\x0d

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Reload config
keybind = cmd+shift+comma=reload_config

# --- Performance ---
scrollback-limit = 100000

# >>> herdr-radar font block
# Written by herdr's own installer (font for its sidebar agent icons). It edits
# the live Ghostty config, which is symlinked to this repo, so it shows up here
# after running herdr's setup. Additive: maps codepoints to the icon font so the
# herdr sidebar renders agent states. Reload Ghostty (Cmd+Shift+,) to apply.
font-codepoint-map = U+E1A0-U+E1BA=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
# <<< herdr-radar font block
